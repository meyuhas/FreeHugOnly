# FHO: Free Hugs Only - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side key used by the API routes / lib/supabase.js.
# Recommended for write operations (bypasses RLS). If omitted, the client
# falls back to the anon key above.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: OpenAI for Honey Filter AI features
OPENAI_API_KEY=your-openai-key
