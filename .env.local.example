# FHO / Sugar Cloud — environment variables
# Copy this file to .env.local and fill in your values.

# ── Supabase (Settings → API) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side super-key used by the API routes (bypasses RLS for secured writes).
# Set ONLY in server env (e.g. Vercel) — never in NEXT_PUBLIC_*, never in git.
# If omitted, lib/supabase.js falls back to the anon key (reads only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Rate limiting (optional) ───────────────────────────────────────────────
# When set, the per-key rate limit becomes a true global limit across serverless
# instances (Upstash Redis REST). When unset, it falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Webhooks (optional) ────────────────────────────────────────────────────
# Shared secret that protects POST /api/webhooks/dispatch (call it from a cron).
CRON_SECRET=
# HMAC key used to sign outgoing webhook payloads (X-FHO-Signature header).
WEBHOOK_SIGNING_SECRET=
